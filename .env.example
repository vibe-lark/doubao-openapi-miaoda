# 仅为业务配置模板；真实值在自己的妙搭应用 dev/online 环境变量中设置。
# 不要用此文件覆盖妙搭 CLI 拉取的 .env.local（其中包含平台配置）。
DOUBAO_APP_ID=cli_your_app_id
DOUBAO_APP_SECRET=
DOUBAO_SCOPES=offline_access contact:user.base:readonly doubao:session:read doubao:session:write doubao:session.event:write doubao:session.message:read
DOUBAO_REDIRECT_URI=https://your-tenant.feishu.link/app/app_your_app_id/oauth/callback
# 使用 32 字节随机密钥的 Base64；不能把真实密钥提交到仓库。
DOUBAO_TOKEN_KEY=
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
